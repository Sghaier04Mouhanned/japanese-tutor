# Copy this file to .env and fill in your own values. .env is git-ignored.

# Where your progress is stored (default: data/tutor.db)
# TUTOR_DB_PATH=data/tutor.db

# --- AI providers ---
# Free key from https://aistudio.google.com
GEMINI_API_KEY=

# Optional: force a model instead of choosing one in the app's ⚙ settings
# GEMINI_MODEL=gemini-flash-latest

# Local models via Ollama (https://ollama.com)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:4b
